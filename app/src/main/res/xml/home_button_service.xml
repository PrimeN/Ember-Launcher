<?xml version="1.0" encoding="utf-8"?>
<!-- Ember's Home button service: watches only for the TV's own home screen coming to the front.
     Key filtering is switched on at run time, only in "Catch the Home press" mode. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:description="@string/home_service_description"
    android:summary="@string/home_service_summary" />
