<?xml version="1.0" encoding="UTF-8"?>
<!-- Deliberate exceptions; anything else lint finds still counts. -->
<lint>
    <!-- TV-only ARM builds (arm64-v8a, armeabi-v7a); ChromeOS x86_64 is not a target. -->
    <issue id="ChromeOsAbiSupport" severity="ignore" />
    <!-- targetSdk is raised one step at a time with a TV test pass (now 35). -->
    <issue id="OldTargetApi" severity="ignore" />
    <!-- commons-net ships an optional accept-all manager; Ember's FTPS uses the system trust store. -->
    <issue id="TrustAllX509TrustManager">
        <ignore path="**/commons-net/**" />
        <ignore path="**/commons-net-*.jar" />
    </issue>
    <!-- TV launcher banners are specified at 320 x 180 dp. -->
    <issue id="VectorRaster">
        <ignore path="**/drawable/banner*.xml" />
    </issue>
    <!-- Screensaver photos use whole-folder access; partial "selected photos" access is not offered. -->
    <issue id="SelectedPhotoAccess" severity="ignore" />
</lint>
